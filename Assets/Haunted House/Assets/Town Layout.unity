MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1612378024}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d700114f32601d240bd40bcb1db0c952, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Dialogue
  dialoguePanel: {fileID: 422561316}
  nameText: {fileID: 194812276}
  dialogueText: {fileID: 1632677725}
  choiceButtons: {fileID: 743667848}
  enterButton: {fileID: 989245210}
  stayButton: {fileID: 2103549103}
  npcName: MR. PEEK N. BOO
  houseSceneName: Level 1
  thisNPCHouseID: 1
  initialDialogue:
  - 'Why hello Casper! Happy Halloween! Quite the ghost you are. '
  - "HAHA! Sorry my boy we dont have much of a treat but a trick! The entire neighborhood
    actually set up something special for this year\u2019s halloween! "
  - 'Each house has a treat waiting for you. Once you get the treat we will give
    you a riddle to find the next house to visit. '
  - 'So, carry on then my boy! Find the treat then to next riddle.   '
  hintDialogue:
  - "\u201CA witch\u2019s brew begins to pop,\r\nBubbles rising \u2014 plip, plip,
    plop.  \r\nCount the bursts that you can see,   \r\nHow many jumped with glee?\u201D"
